# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.pyd
.venv/
.pytest_cache/
.pytest-tmp/

# 本地配置和密钥
.env
.streamlit/secrets.toml

# 运行时数据
storage/*.db
storage/*.db-*
data/inbox/*
data/output/*
outputs/*
logs/*.log

# 保留空目录的占位文件
!storage/.gitkeep
!data/inbox/.gitkeep
!data/output/.gitkeep
!outputs/.gitkeep
!logs/.gitkeep

# 编辑器和系统文件
.idea/
.vscode/
!.vscode/
!.vscode/settings.json
!.vscode/launch.json
.DS_Store
Thumbs.db
