# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.pyd
.venv/
.pytest_cache/
.pytest-tmp/

# 本地配置和密钥
.env
.streamlit/secrets.toml

# 运行时数据
storage/*.db
storage/*.db-*
data/inbox/*
data/output/*
outputs/*
logs/*.log
eval/predictions/*.json
eval/predictions/**/*.json
eval/output/*
eval/ground_truth/*.json
eval/ground_truth/seed/*.json
eval/ground_truth/evaluation/*.json
literature/optical-communications/final_holdout/
literature/**/*.pdf
eval/ground_truth_final_holdout/*.json
eval/ground_truth_final_holdout_recheck/*.json

# 保留空目录的占位文件
!storage/.gitkeep
!data/inbox/.gitkeep
!data/output/.gitkeep
!outputs/.gitkeep
!logs/.gitkeep
!eval/predictions/.gitkeep
!eval/output/.gitkeep
!eval/output/final-holdout-v1/
eval/output/final-holdout-v1/*
!eval/output/final-holdout-v1/version-convention-analysis.md
!eval/output/final-holdout-v1/atomic-fact-coverage.md
!eval/output/final-holdout-v1/method-name-metric-v2.md
!eval/output/final-holdout-v1/ablation-rerun.md
!eval/ground_truth/.gitkeep
!eval/ground_truth/_template.json
!eval/ground_truth/seed/.gitkeep
!eval/ground_truth/evaluation/.gitkeep
!eval/ground_truth_final_holdout/.gitkeep
!eval/ground_truth_final_holdout_recheck/_template.json

# 编辑器和系统文件
.idea/
.vscode/
!.vscode/
!.vscode/settings.json
!.vscode/launch.json
.DS_Store
Thumbs.db
